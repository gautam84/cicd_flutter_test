default_platform(:ios)

BUNDLE_ID = "com.example.cicdFlutterTest"

platform :ios do
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
  end

  desc "Run once locally: create the ad-hoc certificate and profile and store them in the match repo"
  lane :certificates do
    match(type: "adhoc", api_key: asc_api_key, readonly: false)
  end

  desc "Register a tester device, then refresh the ad-hoc profile to include it"
  lane :add_device do |options|
    register_devices(devices: { options[:name] => options[:udid] }, api_key: asc_api_key)
    match(type: "adhoc", api_key: asc_api_key, force_for_new_devices: true)
  end

  # The IPA has no provisioning profile, so it cannot be installed or uploaded to Firebase.
  desc "No Apple account yet: build an IPA signed with a throwaway self-signed certificate"
  lane :dummy_sign do
    require "securerandom"
    require "shellwords"

    # Ruby code runs inside ios/fastlane, so ../.. is the Flutter project root.
    root = File.expand_path("../..")
    work = File.join(root, "build/ios/dummy_sign")
    keychain = File.join(work, "dummy.keychain-db")
    app = File.join(root, "build/ios/iphoneos/Runner.app")
    ipa_dir = File.join(root, "build/ios/ipa")
    password = SecureRandom.hex(16)
    q = ->(s) { Shellwords.escape(s) }

    sh("rm -rf #{q[work]} && mkdir -p #{q[work]}")

    # 1. Self-signed code-signing certificate. /usr/bin/openssl (LibreSSL) writes a .p12 macOS can import.
    File.write(File.join(work, "cert.cnf"), <<~CNF)
      [req]
      distinguished_name = dn
      x509_extensions = ext
      prompt = no
      [dn]
      CN = Dummy iOS Signing
      [ext]
      basicConstraints = critical, CA:false
      keyUsage = critical, digitalSignature
      extendedKeyUsage = critical, codeSigning
    CNF
    sh("cd #{q[work]} && /usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -days 30 " \
       "-config cert.cnf -keyout key.pem -out cert.pem")
    sh("cd #{q[work]} && /usr/bin/openssl pkcs12 -export -inkey key.pem -in cert.pem " \
       "-out cert.p12 -passout pass:#{password}")
    identity = sh("/usr/bin/openssl x509 -in #{q[work]}/cert.pem -noout -fingerprint -sha1", log: false)
               .split("=").last.delete(":").strip

    # 2. Temporary keychain holding only the dummy identity.
    original_keychains = sh("security list-keychains -d user", log: false).split.map { |k| k.delete('"') }
    sh("security create-keychain -p #{password} #{q[keychain]}")
    begin
      sh("security set-keychain-settings #{q[keychain]}")
      sh("security unlock-keychain -p #{password} #{q[keychain]}")
      sh("security import #{q[work]}/cert.p12 -k #{q[keychain]} -P #{password} -T /usr/bin/codesign")
      sh("security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k #{password} #{q[keychain]} > /dev/null")
      # codesign only resolves identities from keychains on the search list.
      sh("security list-keychains -d user -s #{([keychain] + original_keychains).map { |k| q[k] }.join(' ')}")
      # CI runners refuse untrusted identities; trusting needs admin (passwordless sudo on GitHub runners).
      if ENV["CI"]
        sh("sudo security add-trusted-cert -d -r trustRoot -p codeSign -k #{q[keychain]} #{q[work]}/cert.pem")
      end
      sh("security find-identity -p codesigning #{q[keychain]}")

      # 3. Unsigned build.
      sh("cd #{q[root]} && flutter build ios --release --no-codesign --build-number=#{ENV.fetch('BUILD_NUMBER', '1')}")

      # 4. Sign inside-out: embedded frameworks first, then the app.
      sign = "codesign --force --timestamp=none --keychain #{q[keychain]} --sign #{identity}"
      Dir.glob(File.join(app, "Frameworks", "*.{framework,dylib}")).each { |f| sh("#{sign} #{q[f]}") }
      sh("#{sign} #{q[app]}")
      sh("codesign --verify --deep --strict --verbose=2 #{q[app]}")
    ensure
      sh("security list-keychains -d user -s #{original_keychains.map { |k| q[k] }.join(' ')}")
      sh("security delete-keychain #{q[keychain]}")
    end

    # 5. Package as an IPA.
    sh("mkdir -p #{q[work]}/Payload #{q[ipa_dir]} && cp -R #{q[app]} #{q[work]}/Payload/")
    sh("cd #{q[work]} && rm -f #{q[ipa_dir]}/Runner.ipa && zip -qry #{q[ipa_dir]}/Runner.ipa Payload")
    UI.success("Dummy-signed IPA: #{ipa_dir}/Runner.ipa")
  end

  desc "Build an ad-hoc IPA and upload it to Firebase App Distribution"
  lane :distribute do
    setup_ci if ENV["CI"]
    match(type: "adhoc", api_key: asc_api_key, readonly: true)

    profile = ENV["sigh_#{BUNDLE_ID}_adhoc_profile-name"]
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      targets: ["Runner"],
      team_id: "XV6K8UQZCJ",
      code_sign_identity: "Apple Distribution",
      profile_name: profile
    )

    # Compile Flutter code and run pod install; signing is done by gym below.
    sh("cd ../.. && flutter build ios --release --no-codesign --build-number=#{ENV.fetch('BUILD_NUMBER', '1')}")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "ad-hoc",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile } },
      output_directory: "../build/ios/ipa",
      output_name: "Runner.ipa"
    )

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_IOS_APP_ID"),
      service_credentials_file: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_FILE"),
      ipa_path: "../build/ios/ipa/Runner.ipa",
      groups: ENV["FIREBASE_TESTER_GROUPS"],
      release_notes: ENV.fetch("RELEASE_NOTES", "")
    )
  end
end
